<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.scoula.member.mapper.MemberMapper">

    <!-- 회원 등록 (Create) -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="no">
        INSERT INTO tbl_member (username, password, email, birthYear)
        VALUES (#{username}, #{password}, #{email}, #{birthYear})
    </insert>

    <!-- 회원 목록 조회 (Read - List) -->
    <select id="getList" resultType="org.scoula.member.domain.MemberVO">
        SELECT * FROM tbl_member ORDER BY no DESC
    </select>

    <!-- 회원 단일 조회 (Read - Single) -->
    <select id="read" resultType="org.scoula.member.domain.MemberVO">
        SELECT * FROM tbl_member WHERE no = #{no}
    </select>

    <!-- 회원 정보 수정 (Update) -->
    <update id="update">
        UPDATE tbl_member
        SET username = #{username},
            password = #{password},
            email = #{email},
            birthYear = #{birthYear},
            updatedDate = NOW()
        WHERE no = #{no}
    </update>

    <!-- 회원 삭제 (Delete) -->
    <delete id="delete">
        DELETE FROM tbl_member WHERE no = #{no}
    </delete>

</mapper>
